# Moonshadow Headquarters — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to git.

# Supabase — database, auth, storage, edge functions
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side secrets (NEVER put these in .env or the repo).
# Set once with: supabase secrets set NAME=value   (or Supabase dashboard > Edge Functions > Secrets)
#   OPENAI_API_KEY        used by generate-script
#   OPENAI_MODEL          optional, default gpt-4o-mini
#   PATH_API_URL / PATH_API_SECRET   Moonshadow Path
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   YouTube upload (planned)
#
# GitHub repo secrets for .github/workflows/deploy-supabase.yml:
#   SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, SUPABASE_PROJECT_REF
