# Moonshadow Headquarters — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to git.

# Supabase — database, auth, storage, edge functions
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Supabase Edge Functions / backend publishers)
# Do NOT expose these in frontend bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# YouTube channel publisher credentials (server-side only)
YOUTUBE_MOONSHADOW_CLIENT_ID=your-oauth-client-id
YOUTUBE_MOONSHADOW_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_MOONSHADOW_REFRESH_TOKEN=your-oauth-refresh-token
YOUTUBE_KIMMY_CLIENT_ID=your-oauth-client-id
YOUTUBE_KIMMY_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_KIMMY_REFRESH_TOKEN=your-oauth-refresh-token
YOUTUBE_COMEDY_STUDIO_CLIENT_ID=your-oauth-client-id
YOUTUBE_COMEDY_STUDIO_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_COMEDY_STUDIO_REFRESH_TOKEN=your-oauth-refresh-token
YOUTUBE_STORY_CULTURE_STUDIO_CLIENT_ID=your-oauth-client-id
YOUTUBE_STORY_CULTURE_STUDIO_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_STORY_CULTURE_STUDIO_REFRESH_TOKEN=your-oauth-refresh-token
YOUTUBE_IDEA_LAB_CLIENT_ID=your-oauth-client-id
YOUTUBE_IDEA_LAB_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_IDEA_LAB_REFRESH_TOKEN=your-oauth-refresh-token
