# Social promotion hub + platform credentials (server-side only)
SOCIAL_PROMOTION_HUB_PROVIDER=your-provider-name
SOCIAL_PROMOTION_HUB_API_KEY=your-api-key
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
