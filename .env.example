# Moonshadow Headquarters — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to git.

# Supabase — database, auth, storage, edge functions
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Supabase Edge Functions / backend publishers).
# In production, set these with Supabase secrets (or equivalent backend secret manager),
# not in the frontend host environment.
# Use local .env values only when running Edge Functions locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PATH_API_URL=https://moonshadow-path-proof.vercel.app
PATH_API_SECRET=your-path-api-secret-if-required

# YouTube channel publisher credentials (server-side only)
YOUTUBE_MOONSHADOW_CLIENT_ID=your-oauth-client-id
YOUTUBE_MOONSHADOW_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_MOONSHADOW_REFRESH_TOKEN=your-oauth-refresh-token
